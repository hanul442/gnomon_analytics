{
  "name": "gnomon-analytics",
  "version": "0.0.1",
  "private": true,
  "description": "GNOMON (그노몬): evidence-first daily research reports",
  "type": "module",
  "scripts": {
    "build:orbs": "node scripts/build-orbs.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "daily": "node dist/cli/daily.js",
    "test:ui": "npm run build && node scripts/check-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "lightweight-charts": "5.2.1",
    "pretendard": "1.3.9",
    "zod": "^4.6.5"
  }
}
